---
import "../styles/global.css";
import "../styles/progressive-reveal.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Localhost — Automatización, web, SEO e IA con criterio",
  description = "The Localhost automatiza procesos, diseña y desarrolla webs que convierten, conecta herramientas y aplica IA con criterio.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://thelocalhost.es");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('progressive-js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#090b19" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="mobile-locked">
    <slot />
  </body>
</html>
