---
import BrandLogo from "../shared/BrandLogo.astro";
import LanguageMenu from "../shared/LanguageMenu.astro";
import AboutModal from "../shared/AboutModal.astro";
---

<header class="nav desktop-header">
  <div class="container nav-inner">
    <a href="#top" class="brand" aria-label="The Localhost, volver arriba">
      <BrandLogo gradientId="desktopBrandGradient" class="brand-mark-svg" />
      <span class="brand-copy">
        <span class="brand-name">The Localhost</span>
        <span class="brand-tagline">Automatización de procesos</span>
      </span>
    </a>

    <LanguageMenu
      classPrefix="desktop-language"
      wrapId="desktopLanguageWrap"
      triggerId="desktopLanguageTrigger"
      menuId="desktopLanguageMenu"
    />

    <button
      class="desktop-about-trigger"
      type="button"
      aria-label="Quién está detrás de The Localhost"
      data-about-trigger="desktopAboutModal"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="8" r="3.2"></circle>
        <path d="M5.8 19c.7-3.4 3-5.1 6.2-5.1s5.5 1.7 6.2 5.1"></path>
      </svg>
    </button>
  </div>
</header>

<AboutModal classPrefix="desktop-about" modalId="desktopAboutModal" closeId="desktopAboutClose" titleId="desktopAboutTitle" />

<style>
  .desktop-header {
    display: none;
  }

  @media (min-width: 1100px) {
    .desktop-header {
      display: block;
    }
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    background: rgba(6, 9, 19, 0.72);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    min-height: var(--header-height-desktop);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.46rem;
    width: max-content;
    max-width: 100%;
  }

  :global(.brand-mark-svg) {
    flex: 0 0 auto;
    width: 47px;
    height: 47px;
    display: block;
  }

  .brand-copy {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: start;
    align-items: start;
    min-width: 0;
    font-family: "Inter", var(--sans);
    color: #fff;
    line-height: 1;
    text-align: left;
  }

  .brand-name,
  .brand-tagline {
    display: block;
    width: 100%;
    margin-left: 0;
    padding-left: 0;
    text-align: left;
  }

  .brand-name {
    font-size: 1.24rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .brand-tagline {
    margin-top: 0.22rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.92);
  }

  .desktop-about-trigger {
    position: absolute;
    right: 1.2rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    background: rgba(255, 255, 255, 0.035);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .desktop-about-trigger:hover {
    border-color: rgba(255, 68, 124, 0.34);
    background: rgba(255, 68, 124, 0.06);
  }

  .desktop-about-trigger:active {
    transform: translateY(-50%) scale(0.96);
  }

  .desktop-about-trigger svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
