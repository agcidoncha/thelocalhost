---
---

<section class="section diagnosis-section" id="experiencia">
  <div class="container">
    <div class="section-head diagnosis-head reveal">
      <p class="eyebrow">Diagnóstico rápido</p>
      <h2>Cuéntame qué quieres mejorar.</h2>
      <p>Responde 4 preguntas y te mostramos dónde vemos una oportunidad de mejora.</p>
    </div>

    <div class="diagnosis-shell reveal" id="businessDiagnosis">
      <div class="diagnosis-top">
        <span class="diagnosis-label">Diagnóstico The Localhost</span>
        <span class="diagnosis-counter" id="diagnosisCounter">01 / 04</span>
      </div>
      <div class="diagnosis-progress" aria-hidden="true">
        <span id="diagnosisProgress"></span>
      </div>

      <div class="diagnosis-body">
        <div class="diagnosis-step is-active" data-diagnosis-step="1" data-selection="multi">
          <p class="diagnosis-step-kicker">Pregunta 01</p>
          <h3 class="diagnosis-question">¿Qué quieres mejorar?</h3>
          <p class="diagnosis-copy">Puedes elegir varios objetivos si todos son importantes para tu negocio.</p>
          <div class="diagnosis-options">
            <button class="diagnosis-option" type="button" data-answer-key="goal" data-answer-value="clientes">Captar clientes</button>
            <button class="diagnosis-option" type="button" data-answer-key="goal" data-answer-value="tiempo">Ahorrar tiempo</button>
            <button class="diagnosis-option" type="button" data-answer-key="goal" data-answer-value="respuesta">Responder más rápido</button>
            <button class="diagnosis-option" type="button" data-answer-key="goal" data-answer-value="organizacion">Organizar mejor</button>
            <button class="diagnosis-option" type="button" data-answer-key="goal" data-answer-value="repetitivas">Automatizar tareas repetitivas</button>
          </div>
        </div>

        <div class="diagnosis-step" data-diagnosis-step="2" data-selection="multi">
          <p class="diagnosis-step-kicker">Pregunta 02</p>
          <h3 class="diagnosis-question">¿En qué parte del trabajo lo notas?</h3>
          <p class="diagnosis-copy">Puedes elegir varias si el problema aparece en más de un punto del proceso.</p>
          <div class="diagnosis-options">
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="email">Email</button>
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="whatsapp">WhatsApp</button>
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="web">Web / formularios</button>
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="reservas">Reservas / citas</button>
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="facturacion">Facturación</button>
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="crm">CRM / seguimiento</button>
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="redes">Redes sociales</button>
            <button class="diagnosis-option" type="button" data-answer-key="area" data-answer-value="otro">Otro</button>
          </div>
        </div>

        <div class="diagnosis-step" data-diagnosis-step="3" data-selection="multi">
          <p class="diagnosis-step-kicker">Pregunta 03</p>
          <h3 class="diagnosis-question">¿Qué pasa hoy con ese trabajo?</h3>
          <p class="diagnosis-copy">Puedes elegir varias si el proceso combina distintos pasos o formas de gestión.</p>
          <div class="diagnosis-options">
            <button class="diagnosis-option" type="button" data-answer-key="current" data-answer-value="manual">Lo gestiono manualmente</button>
            <button class="diagnosis-option" type="button" data-answer-key="current" data-answer-value="excel">Apunto o copio datos en Excel</button>
            <button class="diagnosis-option" type="button" data-answer-key="current" data-answer-value="herramientas">Paso información entre varias herramientas</button>
            <button class="diagnosis-option" type="button" data-answer-key="current" data-answer-value="falla">Ya tengo una automatización, pero falla</button>
          </div>
        </div>

        <div class="diagnosis-step" data-diagnosis-step="4" data-selection="single">
          <p class="diagnosis-step-kicker">Pregunta 04</p>
          <h3 class="diagnosis-question">¿Cuánto te afecta este proceso?</h3>
          <p class="diagnosis-copy">Elige una sola opción: la que mejor describa su impacto real en el día a día.</p>
          <div class="diagnosis-options">
            <button class="diagnosis-option" type="button" data-answer-key="load" data-answer-value="poco">Bajo · molesta, pero se gestiona</button>
            <button class="diagnosis-option" type="button" data-answer-key="load" data-answer-value="semana">Medio · me quita varias horas a la semana</button>
            <button class="diagnosis-option" type="button" data-answer-key="load" data-answer-value="dia">Alto · me quita varias horas al día</button>
            <button class="diagnosis-option" type="button" data-answer-key="load" data-answer-value="serio">Crítico · provoca bloqueos, errores o pérdida de seguimiento</button>
          </div>
        </div>

        <div class="diagnosis-nav" id="diagnosisNav">
          <button class="diagnosis-back" type="button" id="diagnosisBack">← Anterior</button>
          <div class="diagnosis-nav-actions">
            <span class="diagnosis-hint" id="diagnosisHint">Puedes elegir varias opciones</span>
            <button class="diagnosis-next" type="button" id="diagnosisNext" disabled>Continuar →</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="diagnosis-result" id="diagnosisResult" aria-live="polite" role="dialog" aria-modal="true" aria-labelledby="diagnosisHeadline">
  <div class="diagnosis-report" role="document">
    <button class="diagnosis-modal-close" type="button" id="diagnosisModalClose" aria-label="Cerrar diagnóstico">×</button>

    <div class="diagnosis-result-top">
      <div>
        <p class="diagnosis-step-kicker">Tu diagnóstico</p>
        <h3 id="diagnosisHeadline">Hay una oportunidad clara de mejora.</h3>
        <p class="diagnosis-result-lead" id="diagnosisPriorityText"></p>
      </div>
      <span class="diagnosis-priority" id="diagnosisPriority">Oportunidad clara</span>
    </div>

    <div class="diagnosis-opportunities" id="diagnosisOpportunityList"></div>

    <div class="diagnosis-start">
      <span class="diagnosis-start-label">Por dónde empezaría</span>
      <p id="diagnosisStartText"></p>
    </div>

    <div class="diagnosis-summary" id="diagnosisSummary" aria-label="Resumen de respuestas"></div>

    <div class="diagnosis-result-cta" id="contacto">
      <p>Si quieres que revisemos este caso con contexto real de tu negocio, el siguiente paso será enviarnos este diagnóstico.</p>
      <button class="diagnosis-study-btn" type="button" id="diagnosisStudyButton">Quiero que estudiéis mi caso →</button>
    </div>

    <div class="diagnosis-contact-choice" id="diagnosisContactChoice">
      <p class="diagnosis-step-kicker">Seguimos</p>
      <h3>¿Cómo prefieres hablar?</h3>
      <p>Elige el canal que te resulte más cómodo. Te dejamos el mensaje preparado con el contexto básico del diagnóstico.</p>

      <div class="diagnosis-contact-actions">
        <a class="diagnosis-contact-button whatsapp" id="diagnosisWhatsApp" href="#" target="_blank" rel="noopener">
          <span>WhatsApp</span>
        </a>

        <a class="diagnosis-contact-button email" id="diagnosisEmail" href="mailto:angel@thelocalhost.es">
          <span>Email</span>
        </a>

        <a class="diagnosis-contact-button call" id="diagnosisCall" href="mailto:angel@thelocalhost.es">
          <span>Reservar una llamada</span>
        </a>
      </div>

      <button class="diagnosis-contact-back" type="button" id="diagnosisContactBack">← Volver al diagnóstico</button>
    </div>

    <button class="diagnosis-restart" type="button" id="diagnosisRestart">← Revisar mis respuestas</button>
  </div>
</div>

<script>
  import {
    diagnosisLabels,
    areaResults,
    currentResults,
    goalResults,
    areaGoalScores,
    priorityResults,
  } from "../../lib/diagnosis-data.js";

  const diagnosisRoot = document.getElementById("businessDiagnosis");

  if (diagnosisRoot) {
    const diagnosisSteps = Array.from(diagnosisRoot.querySelectorAll(".diagnosis-step"));
    const diagnosisResult = document.getElementById("diagnosisResult");
    const diagnosisCounter = document.getElementById("diagnosisCounter");
    const diagnosisProgress = document.getElementById("diagnosisProgress");
    const diagnosisBack = document.getElementById("diagnosisBack");
    const diagnosisNext = document.getElementById("diagnosisNext");
    const diagnosisHint = document.getElementById("diagnosisHint");
    const diagnosisNav = document.getElementById("diagnosisNav");
    const diagnosisRestart = document.getElementById("diagnosisRestart");
    const diagnosisStudyButton = document.getElementById("diagnosisStudyButton");
    const diagnosisContactChoice = document.getElementById("diagnosisContactChoice");
    const diagnosisWhatsApp = document.getElementById("diagnosisWhatsApp");
    const diagnosisEmail = document.getElementById("diagnosisEmail");
    const diagnosisCall = document.getElementById("diagnosisCall");
    const diagnosisContactBack = document.getElementById("diagnosisContactBack");
    const diagnosisModalClose = document.getElementById("diagnosisModalClose");
    const diagnosisHeadline = document.getElementById("diagnosisHeadline");
    const diagnosisPriority = document.getElementById("diagnosisPriority");
    const diagnosisPriorityText = document.getElementById("diagnosisPriorityText");
    const diagnosisOpportunityList = document.getElementById("diagnosisOpportunityList");
    const diagnosisStartText = document.getElementById("diagnosisStartText");
    const diagnosisSummary = document.getElementById("diagnosisSummary");

    const diagnosisAnswers = {
      goal: [],
      area: [],
      current: [],
      load: null,
    };

    let diagnosisStepIndex = 0;

    function answerCountForKey(key) {
      const answer = diagnosisAnswers[key];
      return Array.isArray(answer) ? answer.length : answer ? 1 : 0;
    }

    /*
     * Reposiciona la pregunta activa dejando hueco para la cabecera que esté
     * realmente visible en ese momento (nav de escritorio o compacta de
     * mobile) — a diferencia del original, que asumía una altura de 76px
     * fija porque cada documento solo conocía su propia cabecera. Aquí
     * ambas cabeceras conviven en el DOM, así que medimos la real.
     */
    function visibleHeaderHeight() {
      const desktopNav = document.querySelector(".nav.desktop-header");
      if (desktopNav) {
        const height = desktopNav.getBoundingClientRect().height;
        if (height > 0) return height;
      }
      if (document.body.classList.contains("compact-header-visible")) {
        const compact = document.querySelector(".mobile-compact-header");
        if (compact) return compact.getBoundingClientRect().height;
      }
      return 0;
    }

    function repositionDiagnosis() {
      if (!diagnosisRoot) return;
      /* Desktop: la sección permanece display:none hasta 'diagnosis-unlocked'.
         Mobile: permanece display:none hasta 'intro-ready'. En vez de
         acoplar esta función a un nombre de clase concreto de un solo
         flujo, comprobamos si el navegador ya la está pintando de verdad. */
      const section = document.getElementById("experiencia");
      if (section && getComputedStyle(section).display === "none") return;

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const viewport = window.visualViewport;
          const viewportHeight = viewport ? viewport.height : window.innerHeight;
          const viewportOffsetTop = viewport ? viewport.offsetTop : 0;

          const navHeight = visibleHeaderHeight();
          const topGap = 22;
          const bottomGap = 28;

          const visibleTop = viewportOffsetTop + navHeight + topGap;
          const visibleBottom = viewportOffsetTop + viewportHeight - bottomGap;

          const rect = diagnosisRoot.getBoundingClientRect();
          const availableHeight = visibleBottom - visibleTop;

          let targetDelta = 0;

          if (rect.height <= availableHeight) {
            const visibleCenter = visibleTop + availableHeight / 2;
            const diagnosisCenter = rect.top + rect.height / 2;
            targetDelta = diagnosisCenter - visibleCenter;
          } else {
            targetDelta = rect.bottom - visibleBottom;
          }

          if (Math.abs(targetDelta) > 1) {
            window.scrollBy({ top: targetDelta, behavior: "smooth" });
          }
        });
      });
    }

    function updateDiagnosisUI() {
      diagnosisSteps.forEach((step, index) => {
        step.classList.toggle("is-active", index === diagnosisStepIndex);
      });

      if (diagnosisResult) diagnosisResult.classList.remove("is-active");
      document.body.classList.remove("diagnosis-modal-open");
      if (diagnosisNav) diagnosisNav.style.display = "";

      const displayStep = diagnosisStepIndex + 1;
      if (diagnosisCounter) diagnosisCounter.textContent = `0${displayStep} / 04`;
      if (diagnosisProgress) diagnosisProgress.style.width = `${displayStep * 25}%`;
      if (diagnosisBack) diagnosisBack.classList.toggle("is-visible", diagnosisStepIndex > 0);

      const activeStep = diagnosisSteps[diagnosisStepIndex];
      if (!activeStep) return;

      const key = activeStep.querySelector(".diagnosis-option")?.dataset.answerKey;
      const isMulti = activeStep.dataset.selection === "multi";
      const answer = key ? diagnosisAnswers[key] : null;

      activeStep.querySelectorAll(".diagnosis-option").forEach((option) => {
        const selected = isMulti
          ? Array.isArray(answer) && answer.includes(option.dataset.answerValue)
          : option.dataset.answerValue === answer;
        option.classList.toggle("is-selected", selected);
        option.setAttribute("aria-pressed", selected ? "true" : "false");
      });

      const hasAnswer = key ? answerCountForKey(key) > 0 : false;
      if (diagnosisNext) {
        diagnosisNext.disabled = !hasAnswer;
        diagnosisNext.textContent =
          diagnosisStepIndex === diagnosisSteps.length - 1 ? "Ver diagnóstico →" : "Continuar →";
      }
      if (diagnosisHint) {
        if (isMulti) {
          const count = answerCountForKey(key);
          diagnosisHint.textContent = count
            ? `${count} seleccionada${count === 1 ? "" : "s"} · puedes marcar más`
            : "Puedes elegir varias opciones";
        } else {
          diagnosisHint.textContent = hasAnswer ? "Opción seleccionada" : "Elige una opción";
        }
      }
    }

    function scoreArea(area) {
      return diagnosisAnswers.goal.reduce((total, goal) => {
        return total + (areaGoalScores[goal]?.[area] || 0);
      }, 0);
    }

    function prioritizedAreas() {
      const selected = diagnosisAnswers.area.filter(Boolean);
      if (selected.length <= 2) return selected;

      return selected
        .map((area, index) => ({ area, index, score: scoreArea(area) }))
        .sort((a, b) => b.score - a.score || a.index - b.index)
        .slice(0, 2)
        .map((item) => item.area);
    }

    function buildCurrentText() {
      const values = new Set(diagnosisAnswers.current);

      if (values.has("falla")) {
        let text = currentResults.falla;
        if (values.has("herramientas")) {
          text +=
            " También comprobaríamos cómo se conectan las herramientas existentes, porque el fallo puede estar en el traspaso de datos entre sistemas.";
        } else if (values.has("manual") && values.has("excel")) {
          text +=
            " Después revisaríamos qué trabajo manual y qué hojas de cálculo pueden simplificarse sin reconstruir todo el proceso.";
        } else if (values.has("excel")) {
          text +=
            " Después revisaríamos qué parte de las hojas de cálculo puede centralizarse sin interferir con el flujo que ya existe.";
        } else if (values.has("manual")) {
          text += " Después revisaríamos qué pasos manuales siguen siendo necesarios y cuáles pueden desaparecer.";
        }
        return text;
      }

      if (values.has("herramientas") && values.has("excel") && values.has("manual")) {
        return "Hoy el proceso mezcla trabajo manual, hojas de cálculo y varias herramientas. El primer paso sería centralizar la información y conectar los sistemas para reducir duplicidades antes de automatizar más.";
      }
      if (values.has("herramientas") && values.has("excel")) {
        return "El principal margen de mejora está en conectar las herramientas y centralizar la información que hoy depende de hojas de cálculo, evitando dobles actualizaciones.";
      }
      if (values.has("herramientas") && values.has("manual")) {
        return "El proceso combina varias herramientas con pasos manuales. Primero conectaríamos los sistemas y después eliminaríamos solo las tareas repetitivas que no necesitan intervención humana.";
      }
      if (values.has("manual") && values.has("excel")) {
        return "Hay dependencia de trabajo manual y hojas de cálculo. La mejora pasaría por centralizar la información y automatizar los pasos repetitivos sin perder control sobre el proceso.";
      }

      const first = diagnosisAnswers.current[0];
      return first ? currentResults[first] || "" : "";
    }

    function goalAlignment(goal, areas) {
      if (!areas.length) return 0;
      return areas.reduce((total, area) => total + (areaGoalScores[goal]?.[area] || 0), 0) / areas.length;
    }

    function bestGoalForArea(area) {
      const goals = diagnosisAnswers.goal;
      if (!goals.length) return null;
      return (
        goals
          .map((goal, index) => ({
            goal,
            index,
            score: areaGoalScores[goal]?.[area] || 0,
          }))
          .sort((a, b) => b.score - a.score || a.index - b.index)[0] || null
      );
    }

    function opportunityOutcomeText(area) {
      const best = bestGoalForArea(area);
      if (!best) return "";
      if (best.goal === "clientes" && best.score <= 1) {
        return "Tu objetivo es captar clientes, pero aquí no asumiríamos una relación directa. Primero comprobaríamos si mejorar este proceso influye realmente en la captación o el seguimiento comercial.";
      }
      return goalResults[best.goal] || "";
    }

    function opportunityActionText(area) {
      if (diagnosisAnswers.current.includes("falla")) {
        const areaLabel = diagnosisLabels.area[area] || area;
        if (area === "otro") {
          return "Primero revisaríamos el flujo que ya existe, localizaríamos dónde falla y comprobaríamos qué parte merece repararse, simplificarse o replantearse.";
        }
        return `Primero revisaríamos la automatización que ya interviene en ${areaLabel}, localizaríamos dónde se rompe el flujo y decidiríamos si conviene repararla, simplificarla o rehacer solo la parte problemática.`;
      }
      return areaResults[area] || "";
    }

    function currentStateText(area) {
      const methodPhrases = {
        manual: "gestión manual",
        excel: "datos apuntados o copiados en Excel",
        herramientas: "traspasos de información entre varias herramientas",
        falla: "una automatización que está fallando",
      };
      const methods = diagnosisAnswers.current.map((value) => methodPhrases[value]).filter(Boolean);

      const areaLabel = diagnosisLabels.area[area] || area;
      if (!methods.length) return `El problema que has señalado está en ${areaLabel}.`;
      if (methods.length === 1) return `${areaLabel}: hoy depende de ${methods[0]}.`;
      return `${areaLabel}: hoy combina ${methods.join(", ").replace(/, ([^,]*)$/, " y $1")}.`;
    }

    function renderOpportunities() {
      if (!diagnosisOpportunityList) return;
      diagnosisOpportunityList.innerHTML = "";

      const areas = prioritizedAreas();
      areas.forEach((area, index) => {
        const article = document.createElement("article");
        article.className = "diagnosis-opportunity";

        const head = document.createElement("div");
        head.className = "diagnosis-opportunity-head";

        const number = document.createElement("span");
        number.className = "diagnosis-opportunity-number";
        number.textContent = String(index + 1).padStart(2, "0");

        const title = document.createElement("div");
        title.className = "diagnosis-opportunity-title";
        title.textContent = diagnosisLabels.area[area] || area;

        const meta = document.createElement("span");
        meta.className = "diagnosis-opportunity-meta";
        meta.textContent = index === 0 ? "Primer frente" : "Segundo frente";

        head.append(number, title, meta);

        const flow = document.createElement("div");
        flow.className = "diagnosis-flow";

        const now = document.createElement("div");
        now.className = "diagnosis-flow-step";
        now.innerHTML = "<strong>Ahora</strong>";
        const nowText = document.createElement("p");
        nowText.textContent = currentStateText(area);
        now.appendChild(nowText);

        const arrow1 = document.createElement("div");
        arrow1.className = "diagnosis-flow-arrow";
        arrow1.textContent = "→";

        const action = document.createElement("div");
        action.className = "diagnosis-flow-step action";
        action.innerHTML = "<strong>Qué haríamos</strong>";
        const actionText = document.createElement("p");
        actionText.textContent = opportunityActionText(area);
        action.appendChild(actionText);

        const arrow2 = document.createElement("div");
        arrow2.className = "diagnosis-flow-arrow";
        arrow2.textContent = "→";

        const outcome = document.createElement("div");
        outcome.className = "diagnosis-flow-step outcome";
        outcome.innerHTML = "<strong>Qué buscamos</strong>";
        const outcomeText = document.createElement("p");
        outcomeText.textContent = opportunityOutcomeText(area);
        outcome.appendChild(outcomeText);

        flow.append(now, arrow1, action, arrow2, outcome);
        article.append(head, flow);
        diagnosisOpportunityList.appendChild(article);
      });

      if (diagnosisStartText) {
        const first = areas[0];
        const firstLabel = first ? diagnosisLabels.area[first] || first : "el proceso principal";
        diagnosisStartText.textContent = `${priorityResults[diagnosisAnswers.load]?.text || ""} Empezaría revisando ${firstLabel} y, antes de añadir nada nuevo, comprobaría cómo encaja con la forma en la que trabajas ahora.`;
      }
    }

    function buildContactMessage() {
      const lines = ["Hola, he hecho el diagnóstico de The Localhost y quiero que estudiéis mi caso.", ""];

      const groups = [
        ["Quiero mejorar", "goal"],
        ["Dónde ocurre", "area"],
        ["Ahora ocurre", "current"],
        ["Impacto", "load"],
      ];

      groups.forEach(([label, key]) => {
        const raw = diagnosisAnswers[key];
        const values = Array.isArray(raw) ? raw : raw ? [raw] : [];
        const labels = values.map((value) => diagnosisLabels[key]?.[value] || value).filter(Boolean);

        if (labels.length) {
          lines.push(`${label}: ${labels.join(", ")}`);
        }
      });

      lines.push("");
      lines.push("Me gustaría que lo revisáramos con más contexto.");

      return lines.join("\n");
    }

    function prepareContactLinks() {
      const message = buildContactMessage();

      if (diagnosisEmail) {
        const subject = "Quiero que estudiéis mi caso";
        diagnosisEmail.href = `mailto:angel@thelocalhost.es?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
      }

      if (diagnosisCall) {
        const callSubject = "Quiero reservar una llamada";
        const callMessage = `${message}\n\nPrefiero comentarlo en una llamada. ¿Qué disponibilidad tienes?`;

        diagnosisCall.href = `mailto:angel@thelocalhost.es?subject=${encodeURIComponent(callSubject)}&body=${encodeURIComponent(callMessage)}`;
      }

      if (diagnosisWhatsApp) {
        diagnosisWhatsApp.href = `https://wa.me/?text=${encodeURIComponent(message)}`;
      }
    }

    function openDiagnosisContactChoice() {
      if (!diagnosisResult) return;

      prepareContactLinks();

      const report = diagnosisResult.querySelector(".diagnosis-report");
      if (report) report.scrollTop = 0;

      diagnosisResult.classList.add("is-contact-mode");
    }

    function closeDiagnosisContactChoice() {
      if (!diagnosisResult) return;

      diagnosisResult.classList.remove("is-contact-mode");

      const report = diagnosisResult.querySelector(".diagnosis-report");
      if (report) report.scrollTop = 0;
    }

    function buildDiagnosisResult() {
      const priority = priorityResults[diagnosisAnswers.load];
      if (!priority) return;

      if (diagnosisResult) {
        diagnosisResult.classList.remove("is-contact-mode");
      }

      diagnosisSteps.forEach((step) => step.classList.remove("is-active"));
      if (diagnosisResult) diagnosisResult.classList.add("is-active");
      document.body.classList.add("diagnosis-modal-open");
      if (diagnosisNav) diagnosisNav.style.display = "none";
      if (diagnosisCounter) diagnosisCounter.textContent = "RESULTADO";
      if (diagnosisProgress) diagnosisProgress.style.width = "100%";

      if (diagnosisHeadline) diagnosisHeadline.textContent = priority.headline;
      if (diagnosisPriority) diagnosisPriority.textContent = priority.label;
      if (diagnosisPriorityText) diagnosisPriorityText.textContent = buildCurrentText();
      renderOpportunities();

      if (diagnosisSummary) {
        diagnosisSummary.innerHTML = "";
        ["goal", "area", "current", "load"].forEach((key) => {
          const raw = diagnosisAnswers[key];
          const values = Array.isArray(raw) ? raw : raw ? [raw] : [];
          values.forEach((value) => {
            const chip = document.createElement("span");
            chip.textContent = diagnosisLabels[key][value] || value || "";
            diagnosisSummary.appendChild(chip);
          });
        });
      }
    }

    diagnosisRoot.querySelectorAll(".diagnosis-option").forEach((option) => {
      option.setAttribute("aria-pressed", "false");
      option.addEventListener("click", () => {
        const key = option.dataset.answerKey;
        const value = option.dataset.answerValue;
        const step = option.closest(".diagnosis-step");
        if (!key || !value || !step) return;

        const isMulti = step.dataset.selection === "multi";
        if (isMulti) {
          const values = diagnosisAnswers[key];

          if (key === "area") {
            if (value === "otro") {
              diagnosisAnswers.area = values.includes("otro") ? [] : ["otro"];
            } else {
              const withoutOther = values.filter((item) => item !== "otro");
              const index = withoutOther.indexOf(value);
              if (index >= 0) {
                withoutOther.splice(index, 1);
              } else {
                withoutOther.push(value);
              }
              diagnosisAnswers.area = withoutOther;
            }
          } else {
            const index = values.indexOf(value);
            if (index >= 0) {
              values.splice(index, 1);
            } else {
              values.push(value);
            }
          }
        } else {
          diagnosisAnswers[key] = value;
        }

        updateDiagnosisUI();
      });
    });

    if (diagnosisNext) {
      diagnosisNext.addEventListener("click", () => {
        const activeStep = diagnosisSteps[diagnosisStepIndex];
        const key = activeStep?.querySelector(".diagnosis-option")?.dataset.answerKey;
        if (!key || answerCountForKey(key) === 0) return;

        if (diagnosisStepIndex < diagnosisSteps.length - 1) {
          diagnosisStepIndex += 1;
          updateDiagnosisUI();
          repositionDiagnosis();
        } else {
          buildDiagnosisResult();
        }
      });
    }

    if (diagnosisBack) {
      diagnosisBack.addEventListener("click", () => {
        if (diagnosisStepIndex <= 0) return;
        diagnosisStepIndex -= 1;
        updateDiagnosisUI();
        repositionDiagnosis();
      });
    }

    function closeDiagnosisModal(returnToLastStep = true) {
      if (diagnosisResult) {
        diagnosisResult.classList.remove("is-active");
        diagnosisResult.classList.remove("is-contact-mode");
      }
      document.body.classList.remove("diagnosis-modal-open");
      if (returnToLastStep) {
        diagnosisStepIndex = diagnosisSteps.length - 1;
        updateDiagnosisUI();
        repositionDiagnosis();
      }
    }

    if (diagnosisStudyButton) {
      diagnosisStudyButton.addEventListener("click", openDiagnosisContactChoice);
    }

    if (diagnosisContactBack) {
      diagnosisContactBack.addEventListener("click", closeDiagnosisContactChoice);
    }

    if (diagnosisModalClose) {
      diagnosisModalClose.addEventListener("click", () => closeDiagnosisModal(true));
    }

    if (diagnosisResult) {
      diagnosisResult.addEventListener("click", (event) => {
        if (event.target === diagnosisResult) closeDiagnosisModal(true);
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && diagnosisResult?.classList.contains("is-active")) {
        closeDiagnosisModal(true);
      }
    });

    if (diagnosisRestart) {
      diagnosisRestart.addEventListener("click", () => {
        diagnosisStepIndex = 0;
        updateDiagnosisUI();
        diagnosisRoot.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }

    updateDiagnosisUI();
  }
</script>
