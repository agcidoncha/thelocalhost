      height:28%;
      border-radius:99px;
      background:linear-gradient(180deg,transparent,rgba(var(--card-accent),.95),transparent);
      box-shadow:0 0 16px rgba(var(--card-accent),.55);

    }
    .time-step{
      position:relative;
      z-index:2;
      display:grid;
      grid-template-columns:58px 1fr auto;
      align-items:center;
      gap:1rem;
      min-height:72px;
      padding: .82rem 1rem .82rem 1rem;
      border:1px solid rgba(255,255,255,.065);
      border-radius:15px;
      background:linear-gradient(90deg,rgba(255,255,255,.028),rgba(255,255,255,.012));
      opacity:1;
      transform:translateX(6px);

    }
    .time-step.step-2{animation-delay:.38s}
    .time-step.step-3{animation-delay:.76s}
    .time-step.step-4{animation-delay:1.14s}

    .time-step::after{
      content:"";
      position:absolute;
      inset:-1px;
      border-radius:15px;
      border:1px solid transparent;
      pointer-events:none;
      opacity:0;
    }

    .tactile-board .need-card.play-sequence .time-step.step-1::after{
      animation:timeStepFinalFrame .42s ease 2.65s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-2::after{
      animation:timeStepFinalFrame .42s ease 3.03s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-3::after{
      animation:timeStepFinalFrame .42s ease 3.41s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-4::after{
      animation:timeStepFinalFrame .42s ease 3.79s forwards;
    }

    .tactile-board .need-card.play-sequence .time-rail span{
      animation:timeRailMove 2.6s linear 1;
    }
    .tactile-board .need-card.play-sequence .time-step{
      animation:timeStepPulse 2.8s var(--ease) 1 forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-1 .time-icon,
    .tactile-board .need-card.play-sequence .time-step.step-1 .time-status{
