      animation:timeBenefitLine .62s var(--ease) forwards;
    }
    .tactile-board .need-card[data-need="tiempo"].play-sequence .open-copy li:nth-child(1)::after{animation-delay:.18s}
    .tactile-board .need-card[data-need="tiempo"].play-sequence .open-copy li:nth-child(2)::after{animation-delay:.38s}
    .tactile-board .need-card[data-need="tiempo"].play-sequence .open-copy li:nth-child(3)::after{animation-delay:.58s}
    .tactile-board .need-card[data-need="tiempo"].play-sequence .open-copy li:nth-child(4)::after{animation-delay:.78s}

    @keyframes timeBenefitEnter{
      0%{
        opacity:0;
        transform:translateY(16px) scale(.985);
        border-color:rgba(var(--card-accent),.08);
        box-shadow:0 0 0 rgba(var(--card-accent),0);
      }
      55%{
        opacity:1;
        transform:translateY(0) scale(1);
        border-color:rgba(var(--card-accent),.95);
        box-shadow:0 0 24px rgba(var(--card-accent),.26), inset 0 1px rgba(255,255,255,.04);
      }
      100%{
        opacity:1;
        transform:translateY(0) scale(1);
        border-color:rgba(var(--card-accent),.62);
        box-shadow:0 0 18px rgba(var(--card-accent),.12), inset 0 1px rgba(255,255,255,.04);
      }
    }

    @keyframes timeBenefitLine{
      0%{
        width:0;
        background:linear-gradient(90deg,rgb(var(--card-accent)),rgba(var(--card-accent),.05));
        box-shadow:0 0 0 rgba(var(--card-accent),0);
      }
      70%{
        width:92px;
        background:linear-gradient(90deg,rgb(var(--card-accent)),rgba(var(--card-accent),.25));
        box-shadow:0 0 16px rgba(var(--card-accent),.42);
      }
      100%{
        width:72px;
        background:linear-gradient(90deg,rgb(var(--card-accent)),rgba(var(--card-accent),.12));
        box-shadow:0 0 10px rgba(var(--card-accent),.22);
      }
    }
    .tactile-board .open-actions{display:flex;flex-wrap:wrap;gap:.7rem}
    .tactile-board .open-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.7rem 1rem;border-radius:12px;font-weight:760;font-size:.88rem;border:1px solid rgba(var(--card-accent),.25);background:rgba(var(--card-accent),.11);color:#fff}
