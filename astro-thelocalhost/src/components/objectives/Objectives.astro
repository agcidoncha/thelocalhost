    @keyframes timeRailMove{
      from{transform:translateY(0)}
      to{transform:translateY(460%)}
    }
    @keyframes timeStepPulse{
      0%{
        opacity:.56;
        transform:translateX(6px);
        border-color:rgba(255,255,255,.065);
      }
      16%,34%{
        opacity:1;
        transform:translateX(0);
        border-color:rgba(var(--card-accent),.28);
        box-shadow:0 12px 32px rgba(var(--card-accent),.07);
      }
      45%{
        opacity:.72;
        transform:translateX(2px);
      }
      100%{
        opacity:1;
        transform:translateX(0);
        border-color:rgba(255,255,255,.065);
      }
    }
    @keyframes timeStepComplete{
      to{
        color:#12ff87;
        border-color:rgba(18,255,135,1);
        background:rgba(18,255,135,.28);
        box-shadow:0 0 34px rgba(18,255,135,.52);
      }
