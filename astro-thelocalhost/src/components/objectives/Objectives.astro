                    <div class="time-rail" aria-hidden="true"><span></span></div>

                    <div class="time-step step-1">
                      <div class="time-icon">◫</div>
                      <div class="time-copy"><strong>Nueva cita</strong><span>El cliente reserva</span></div>
                      <div class="time-status">Entrada</div>
                    </div>
                    <div class="time-step step-2">
                      <div class="time-icon">⟳</div>
                      <div class="time-copy"><strong>Agenda sincronizada</strong><span>El hueco queda actualizado</span></div>
                      <div class="time-status">Sincronizado</div>
                    </div>
                    <div class="time-step step-3">
                      <div class="time-icon">✉</div>
                      <div class="time-copy"><strong>Confirmación enviada</strong><span>El cliente recibe los detalles</span></div>
                      <div class="time-status">Confirmado</div>
                    </div>
                    <div class="time-step step-4">
                      <div class="time-icon">⏱</div>
                      <div class="time-copy"><strong>Recordatorio programado</strong><span>Sale automáticamente a tiempo</span></div>
                      <div class="time-status">Programado</div>
                    </div>
                  </div>
                </div>
              </div>
            </div></div>
