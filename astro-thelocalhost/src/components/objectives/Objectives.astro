    .tactile-board .need-card[data-need="tiempo"].play-sequence .open-copy li:nth-child(4){animation-delay:.78s}

    .tactile-board .need-card[data-need="tiempo"].play-sequence .open-copy li::after,
    .tactile-board .need-card[data-need="clientes"].play-sequence .open-copy li::after,
