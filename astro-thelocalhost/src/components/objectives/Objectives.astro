    /* Entrada secuencial de las 4 cajas de Ahorrar tiempo */
    .tactile-board .need-card[data-need="tiempo"].play-sequence .open-copy li,
    .tactile-board .need-card[data-need="clientes"].play-sequence .open-copy li,
