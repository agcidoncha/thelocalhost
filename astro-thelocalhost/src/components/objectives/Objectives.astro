      animation:timeTextComplete .4s ease 2.65s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-2 .time-icon,
    .tactile-board .need-card.play-sequence .time-step.step-2 .time-status{
      animation:timeStepComplete .4s ease 3.03s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-2 .time-copy strong,
    .tactile-board .need-card.play-sequence .time-step.step-2 .time-copy span{
      animation:timeTextComplete .4s ease 3.03s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-3 .time-icon,
    .tactile-board .need-card.play-sequence .time-step.step-3 .time-status{
      animation:timeStepComplete .4s ease 3.41s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-3 .time-copy strong,
    .tactile-board .need-card.play-sequence .time-step.step-3 .time-copy span{
