    :global(body.is-dragging-cards){cursor:grabbing;user-select:none;-webkit-user-select:none}

    .needs-hint.tactile-hint{margin-top:1.35rem;display:flex;justify-content:center;gap:1.2rem;flex-wrap:wrap;color:#7988a8;font-size:.84rem}
