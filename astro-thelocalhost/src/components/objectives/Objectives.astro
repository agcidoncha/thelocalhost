    }
    .tactile-board .need-card.play-sequence .time-step.step-4 .time-icon,
    .tactile-board .need-card.play-sequence .time-step.step-4 .time-status{
      animation:timeStepComplete .4s ease 3.79s forwards;
    }
    .tactile-board .need-card.play-sequence .time-step.step-4 .time-copy strong,
    .tactile-board .need-card.play-sequence .time-step.step-4 .time-copy span{
