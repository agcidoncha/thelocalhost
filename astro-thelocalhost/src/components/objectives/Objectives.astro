    }
    .time-flow{
      position:relative;
      width:100%;
      height:auto;
      min-height:288px;
      flex:1;
      display:grid;
      grid-template-rows:repeat(4,1fr);
      gap:.62rem;
      padding:.2rem 0;
    }
    .time-rail{
      position:absolute;
      left:25px;
      top:30px;
      bottom:30px;
      width:2px;
      border-radius:99px;
      background:rgba(255,255,255,.075);
      overflow:hidden;
    }
    .time-rail span{
      position:absolute;
      left:0;
      top:-28%;
