    <div class="needs-next-bar objectives-desktop" id="needsNextBar" aria-hidden="true">
      <button class="needs-next-button" id="needsNextButton" type="button">
        <span>Nuestro método claro en 5 pasos</span>
        <span class="needs-next-arrow" aria-hidden="true">→</span>
      </button>
    </div>


<script>
  const needsSection = document.getElementById("necesitas");

        const board = document.getElementById('tactileBoard');
      const cards = board ? Array.from(board.querySelectorAll('.need-card')) : [];
      const needPrev = board ? board.querySelector('.need-nav-prev') : null;
      const needNext = board ? board.querySelector('.need-nav-next') : null;
      const needsNextBar = document.getElementById('needsNextBar');
      const needsNextButton = document.getElementById('needsNextButton');
      const processSection = document.getElementById('proceso');
      const processGrid = processSection ? processSection.querySelector('.process-grid') : null;
      const methodNextBar = document.getElementById('methodNextBar');
      const methodNextButton = document.getElementById('methodNextButton');
      const diagnosisSection = document.getElementById('experiencia');
      const closedNeedsTitle = needsSection ? needsSection.querySelector('.needs-title') : null;
      const closedNeedsHint = needsSection ? needsSection.querySelector('.needs-hint') : null;
      let closedNeedsCenterAnimation = 0;
      let cardAutoCentering = false;
      let methodUnlocking = false;
      let methodAutoCentering = false;
      let methodCompacted = false;
      let methodTouchStartY = null;
      let diagnosisUnlocking = false;
      let hasExploredObjective = false;
      let needsNextUnlocked = false;
      let methodNextUnlocked = false;

      function unlockNeedsNext(){
        if(document.body.classList.contains('method-unlocked')) return;
        document.body.classList.add('needs-next-ready');
        if(needsNextBar) needsNextBar.setAttribute('aria-hidden','false');
      }

      function unlockMethodNext(){
        if(
          methodNextUnlocked ||
          document.body.classList.contains('diagnosis-unlocked')
        ) return;

        methodNextUnlocked = true;
        document.body.classList.add('method-next-ready');

        if(methodNextBar){
          methodNextBar.setAttribute('aria-hidden','false');
        }
      }

      function compactMethodSection(){
        if(
          methodCompacted ||
          methodAutoCentering ||
          !processSection ||
          !document.body.classList.contains('method-unlocked')
        ) return;

        const anchorEl =
          processGrid ||
          processSection.querySelector('.section-head') ||
          processSection;

        const beforeTop = anchorEl.getBoundingClientRect().top;

        methodCompacted = true;
        document.body.classList.add('method-compact');

        /* Forzamos reflow y compensamos la reducción de altura para que
           el pipeline no dé un salto visual al desaparecer el aire. */
        void processSection.offsetHeight;

        const afterTop = anchorEl.getBoundingClientRect().top;
        const correction = afterTop - beforeTop;

        if(Math.abs(correction) > 1){
          window.scrollBy({
            top:correction,
            behavior:'auto'
          });
        }
      }

      function centerClosedNeeds(duration = 520){
        if(
          !needsSection ||
          !closedNeedsTitle ||
          !closedNeedsHint ||
          document.body.classList.contains('method-unlocked')
        ) return;

        /* Cancelamos una recolocación anterior si el usuario ha cerrado
           otra tarjeta antes de que terminara. */
        closedNeedsCenterAnimation += 1;
        const animationId = closedNeedsCenterAnimation;

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if(animationId !== closedNeedsCenterAnimation) return;

            const viewport = window.visualViewport;
            const viewportHeight = viewport ? viewport.height : window.innerHeight;
            const viewportOffsetTop = viewport ? viewport.offsetTop : 0;

            const nav = document.querySelector('.nav');
            const navHeight = nav ? nav.getBoundingClientRect().height : 76;

            /* Desde que existe el sticky, reservamos toda su altura visual.
               Así el centro corresponde al área REAL que queda para las cajas. */
            const stickyHeight =
              needsNextBar &&
              document.body.classList.contains('needs-next-ready') &&
              !document.body.classList.contains('method-unlocked')
                ? needsNextBar.getBoundingClientRect().height
                : 0;

            const visibleTop = viewportOffsetTop + navHeight;
            const visibleBottom =
              viewportOffsetTop + viewportHeight - stickyHeight;
            const visibleCenter =
              visibleTop + (visibleBottom - visibleTop) / 2;

            const titleRect = closedNeedsTitle.getBoundingClientRect();
            const hintRect = closedNeedsHint.getBoundingClientRect();
            const contentCenter =
              titleRect.top + (hintRect.bottom - titleRect.top) / 2;

            const startY = window.scrollY;
            const distance = contentCenter - visibleCenter;

            if(Math.abs(distance) < .5) return;

            const startedAt = performance.now();
            const easeInOutCubic = t =>
              t < .5
                ? 4 * t * t * t
                : 1 - Math.pow(-2 * t + 2, 3) / 2;

            const animate = now => {
              if(
                animationId !== closedNeedsCenterAnimation ||
                methodUnlocking ||
                document.body.classList.contains('method-unlocked')
              ) return;

              const progress = Math.min((now - startedAt) / duration, 1);
              window.scrollTo(
                0,
                startY + distance * easeInOutCubic(progress)
              );

              if(progress < 1){
                requestAnimationFrame(animate);
              }
            };

            requestAnimationFrame(animate);
          });
        });
      }

      function positionNeedNavByTitle(){
        if(!board || !needPrev || !needNext) return;

        /* En pantallas grandes conservamos las flechas laterales originales. */
        if(window.innerWidth > 1300){
          [needPrev, needNext].forEach(button => {
            button.style.left = '';
            button.style.right = '';
            button.style.top = '';
          });
          return;
        }

        const openCard = board.querySelector('.need-card.is-open');
        const title = openCard ? openCard.querySelector('.closed-title') : null;
        if(!openCard || !title) return;

        const boardRect = board.getBoundingClientRect();
        const titleRect = title.getBoundingClientRect();
        const closeButton = openCard.querySelector('.overlay-close');
        const closeRect = closeButton ? closeButton.getBoundingClientRect() : null;

        const prevWidth = needPrev.offsetWidth || 48;
        const nextWidth = needNext.offsetWidth || 48;
        const betweenButtons = 8;
        const titleGap = 16;

        /* Empiezan justo después del final real del título. */
        let startLeft = titleRect.right - boardRect.left + titleGap;

        /* Evitamos que las dos flechas choquen con "Volver a objetivos". */
        if(closeRect){
          const closeLeft = closeRect.left - boardRect.left;
          const maxStart =
            closeLeft - 16 - prevWidth - betweenButtons - nextWidth;

          startLeft = Math.min(startLeft, maxStart);
        }

        /* Nunca permitimos que salgan por el lateral derecho del tablero. */
        const absoluteMax =
          boardRect.width - 12 - prevWidth - betweenButtons - nextWidth;

        startLeft = Math.min(startLeft, absoluteMax);
        startLeft = Math.max(12, startLeft);

        const titleCenterY =
          titleRect.top - boardRect.top + (titleRect.height / 2);

        needPrev.style.left = `${startLeft}px`;
        needPrev.style.right = 'auto';
        needPrev.style.top = `${titleCenterY}px`;

        needNext.style.left =
          `${startLeft + prevWidth + betweenButtons}px`;
        needNext.style.right = 'auto';
        needNext.style.top = `${titleCenterY}px`;
      }

      function scheduleNeedNavPosition(){
        requestAnimationFrame(() => {
          requestAnimationFrame(positionNeedNavByTitle);
        });
      }

      function closeCard(card){
        card.classList.remove('is-open');
        card.classList.remove('play-sequence');
        const trigger = card.querySelector('.card-open');
        if(trigger) trigger.setAttribute('aria-expanded','false');
      }

      function closeBoard(){
        const wasOpen = !!(board && board.classList.contains('has-open'));

        cards.forEach(closeCard);
        if(board) board.classList.remove('has-open');

        /* El siguiente capítulo no aparece al ABRIR la primera caja.
           Aparece cuando el usuario termina esa primera exploración y la CIERRA. */
        if(
          wasOpen &&
          hasExploredObjective &&
          !needsNextUnlocked &&
          !methodUnlocking
        ){
          needsNextUnlocked = true;
          unlockNeedsNext();
        }

        /* Una vez recuperadas las seis cajas, volvemos al mismo criterio
           de centrado con el que llegó originalmente esta sección,
           descontando ahora la altura del sticky inferior. */
        if(wasOpen && !methodUnlocking){
          centerClosedNeeds();
        }
      }

      function centerOpenCard(card, behavior = 'auto'){
        if(!card) return;

        const rect = card.getBoundingClientRect();
        const viewport = window.visualViewport;
        const viewportHeight = viewport ? viewport.height : window.innerHeight;
        const viewportOffsetTop = viewport ? viewport.offsetTop : 0;

        const cardCenter = rect.top + (rect.height / 2);
        const viewportCenter = viewportOffsetTop + (viewportHeight / 2);
        const delta = cardCenter - viewportCenter;

        if(Math.abs(delta) < .5) return;

        window.scrollBy({
          top: delta,
          behavior
        });
      }

      function keepOpenCardCentered(card, duration = 700){
        const startedAt = performance.now();

        const align = now => {
          if(!card || !card.classList.contains('is-open')) return;

          /* Mientras cambia de tamaño, recolocamos la página en cada frame
             para que el centro de la tarjeta siga clavado al centro del viewport. */
          centerOpenCard(card, 'auto');

          if(now - startedAt < duration){
            requestAnimationFrame(align);
          }else{
            centerOpenCard(card, 'auto');
            cardAutoCentering = false;
          }
        };

        requestAnimationFrame(align);
      }

      function openCard(card){
        if(!card || card.classList.contains('is-open') || board.classList.contains('has-open')) return;

        hasExploredObjective = true;
        cards.forEach(closeCard);
        cardAutoCentering = true;

        /* Primero aplicamos completamente el estado abierto. */
        card.classList.add('is-open');
        if(board) board.classList.add('has-open');
        scheduleNeedNavPosition();

        const trigger = card.querySelector('.card-open');
        if(trigger) trigger.setAttribute('aria-expanded','true');

        if(['tiempo','clientes','ia','web','herramientas','medir'].includes(card.dataset.need)){
          card.classList.remove('play-sequence');
          void card.offsetWidth;
          card.classList.add('play-sequence');
        }

        /* Dejamos que la ficha termine de abrirse y después usamos
           el centrado nativo del navegador sobre LA PROPIA tarjeta abierta. */
        window.setTimeout(() => {
          card.scrollIntoView({
            behavior:'smooth',
            block:'center',
            inline:'nearest'
          });

          /* Mientras dura esta recolocación automática, la regla del 50%
             permanece desactivada. */
          window.setTimeout(() => {
            cardAutoCentering = false;
          }, 750);
        }, 500);
      }

      function navigateOpenCard(direction){
        if(!board || !board.classList.contains('has-open')) return;

        const orderedCards = Array.from(board.querySelectorAll('.need-card'));
        const current = board.querySelector('.need-card.is-open');
        if(!current || !orderedCards.length) return;

        const currentIndex = orderedCards.indexOf(current);
        if(currentIndex < 0) return;

        const nextIndex = (currentIndex + direction + orderedCards.length) % orderedCards.length;
        const target = orderedCards[nextIndex];

        cardAutoCentering = true;
        closeCard(current);

        target.classList.add('is-open');
        board.classList.add('has-open');
        scheduleNeedNavPosition();

        const trigger = target.querySelector('.card-open');
        if(trigger) trigger.setAttribute('aria-expanded','true');

        if(['tiempo','clientes','ia','web','herramientas','medir'].includes(target.dataset.need)){
          target.classList.remove('play-sequence');
          void target.offsetWidth;
          target.classList.add('play-sequence');
        }

        /* La nueva ficha conserva el mismo comportamiento de centrado
           que una ficha abierta directamente desde el tablero. */
        window.setTimeout(() => {
          target.scrollIntoView({
            behavior:'smooth',
            block:'center',
            inline:'nearest'
          });

          window.setTimeout(() => {
            cardAutoCentering = false;
          }, 750);
        }, 120);
      }

      if(processGrid){
        const lastProcessStep = processGrid.querySelector('.process-step:last-child');

        if(lastProcessStep){
          lastProcessStep.addEventListener('animationend', event => {
            if(
              event.animationName === 'processStepActivate' &&
              document.body.classList.contains('method-unlocked')
            ){
              unlockMethodNext();
            }
          });
        }
      }

      if(needsNextButton && processSection){
        needsNextButton.addEventListener('click', () => {
          if(methodUnlocking || document.body.classList.contains('method-unlocked')) return;
          methodUnlocking = true;
          closedNeedsCenterAnimation += 1;

          /* El sticky desaparece en cuanto el usuario decide avanzar. */
          if(needsNextBar){
            needsNextBar.classList.add('is-dismissing');
            needsNextBar.setAttribute('aria-hidden','true');
          }

          /* Cerramos una posible tarjeta abierta sin provocar otra navegación. */
          closeBoard();

          window.setTimeout(() => {
            /* El siguiente capítulo entra en el layout solo ahora. */
            methodAutoCentering = true;
            document.body.classList.remove('method-compact');
            document.body.classList.add('method-unlocked');
            void processSection.offsetHeight;

            /* Centramos el bloque completo del método en el viewport visible. */
            const navHeight = 76;
            const rect = processSection.getBoundingClientRect();
            const viewport = window.visualViewport;
            const viewportHeight = viewport ? viewport.height : window.innerHeight;
            const viewportOffsetTop = viewport ? viewport.offsetTop : 0;
            const visibleCenter =
              viewportOffsetTop + navHeight + (viewportHeight - navHeight) / 2;
            const sectionCenter = rect.top + rect.height / 2;
            const delta = sectionCenter - visibleCenter;

            window.scrollBy({
              top:delta,
              behavior:'smooth'
            });

            /* Si el observer todavía no ha disparado la animación del pipeline,
               el propio scroll la activará al entrar en pantalla. */
            window.setTimeout(() => {
              methodUnlocking = false;
              methodAutoCentering = false;
            }, 1100);

            /* Fallback para reduced-motion o navegadores sin animationend:
               el CTA del siguiente capítulo aparece al terminar el recorrido. */
            window.setTimeout(() => {
              if(document.body.classList.contains('method-unlocked')){
                unlockMethodNext();
              }
            }, 3700);
          }, 300);
        });
      }

      if(methodNextButton && diagnosisSection){
        methodNextButton.addEventListener('click', () => {
          if(
            diagnosisUnlocking ||
            document.body.classList.contains('diagnosis-unlocked')
          ) return;

          diagnosisUnlocking = true;

          if(methodNextBar){
            methodNextBar.classList.add('is-dismissing');
            methodNextBar.setAttribute('aria-hidden','true');
          }

          /* 1. Primero reservamos físicamente el siguiente capítulo,
             pero sigue completamente invisible. */
          document.body.classList.add('diagnosis-preparing');
          void diagnosisSection.offsetHeight;

          requestAnimationFrame(() => {
            /* 2. Ahora sí compactamos el método.
               compactMethodSection() conserva la posición visual del pipeline,
               y ya existe altura debajo para que el navegador no haga clamp. */
            compactMethodSection();

            requestAnimationFrame(() => {
              /* 3. Las alturas definitivas ya están resueltas.
                 Revelamos el nuevo capítulo sin cambiar el layout. */
              document.body.classList.add('diagnosis-unlocked');
              document.body.classList.remove('diagnosis-preparing');
              void diagnosisSection.offsetHeight;

              /* 4. Calculamos el destino DESPUÉS de compactar el método.
                 Así todo el scroll se hace en un único movimiento continuo. */
              const navHeight = 76;
              const rect = diagnosisSection.getBoundingClientRect();
              const viewport = window.visualViewport;
              const viewportHeight = viewport ? viewport.height : window.innerHeight;
              const viewportOffsetTop = viewport ? viewport.offsetTop : 0;
              const visibleCenter =
                viewportOffsetTop + navHeight + (viewportHeight - navHeight) / 2;
              const sectionCenter = rect.top + rect.height / 2;
              const delta = sectionCenter - visibleCenter;

              window.scrollBy({
                top:delta,
                behavior:'smooth'
              });

              window.setTimeout(() => {
                diagnosisUnlocking = false;
              }, 1000);
            });
          });
        });
      }

      window.addEventListener('resize', () => {
        if(board && board.classList.contains('has-open')){
          scheduleNeedNavPosition();
        }else if(window.innerWidth > 1300){
          positionNeedNavByTitle();
        }
      });

      if(needPrev){
        needPrev.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();
          navigateOpenCard(-1);
        });
      }

      if(needNext){
        needNext.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();
          navigateOpenCard(1);
        });
      }

      cards.forEach(card => {
        const trigger = card.querySelector('.card-open');
        const close = card.querySelector('.overlay-close');
        if(trigger) trigger.addEventListener('click', () => openCard(card));
        if(close) close.addEventListener('click', event => {
          event.stopPropagation();
          closeBoard();
          if(trigger) trigger.focus({preventScroll:true});
        });
      });

      document.addEventListener('click', event => {
        if(!board || !board.classList.contains('has-open')) return;

        const openCardEl = board.querySelector('.need-card.is-open');
        if(!openCardEl) return;

        if(!openCardEl.contains(event.target)){
          closeBoard();
        }
      });


      /* Una ficha abierta se cierra solo cuando el usuario la ha desplazado
         hasta hacer desaparecer por arriba al menos la mitad de su altura. */
      window.addEventListener('scroll', () => {
        if(cardAutoCentering) return;
        if(!board || !board.classList.contains('has-open')) return;

        const openCardEl = board.querySelector('.need-card.is-open');
        if(!openCardEl) return;

        const rect = openCardEl.getBoundingClientRect();
        const hiddenAbove = Math.max(0, -rect.top);

        if(hiddenAbove >= rect.height / 2 && !openCardEl.classList.contains('is-fading-out')){
          /* Primero desaparece suavemente la tarjeta abierta y, al terminar
             el fade, recuperamos las seis opciones. */
          openCardEl.classList.add('is-fading-out');
          cardAutoCentering = false;

          window.setTimeout(() => {
            closeBoard();
            openCardEl.classList.remove('is-fading-out');
          }, 340);
        }
      }, {passive:true});

      /* Drag & drop táctil mediante Pointer Events.
         El movimiento se escucha en document para que reordenar una tarjeta
         no rompa el arrastre al mover su nodo dentro del DOM. */
      if(board){
        let drag = null;

        board.querySelectorAll('.drag-handle').forEach(handle => {
          handle.addEventListener('pointerdown', event => {
            const card = handle.closest('.need-card');
            if(!card || card.classList.contains('is-open') || board.classList.contains('has-open')) return;

            event.preventDefault();

            const rect = card.getBoundingClientRect();
            const ghost = card.cloneNode(true);
            ghost.classList.remove('is-open','is-drag-source','play-sequence');
            ghost.classList.add('drag-ghost');
            ghost.style.width = rect.width + 'px';
            ghost.style.height = rect.height + 'px';
            ghost.style.left = rect.left + 'px';
            ghost.style.top = rect.top + 'px';
            ghost.querySelectorAll('button,a').forEach(el => el.setAttribute('tabindex','-1'));
            document.body.appendChild(ghost);

            card.classList.add('is-drag-source');
            document.body.classList.add('is-dragging-cards');

            drag = {
              pointerId:event.pointerId,
              card,
              ghost,
              offsetX:event.clientX-rect.left,
              offsetY:event.clientY-rect.top
            };
          });
        });

        document.addEventListener('pointermove', event => {
          if(!drag || event.pointerId !== drag.pointerId) return;

          event.preventDefault();

          drag.ghost.style.left = (event.clientX - drag.offsetX) + 'px';
          drag.ghost.style.top = (event.clientY - drag.offsetY) + 'px';

          drag.ghost.style.visibility = 'hidden';
          const under = document.elementFromPoint(event.clientX,event.clientY);
          drag.ghost.style.visibility = 'visible';

          const target = under && under.closest ? under.closest('.need-card') : null;
          if(!target || target === drag.card || target.classList.contains('is-open') || target.parentElement !== board) return;

          const r = target.getBoundingClientRect();
          const horizontalBand = Math.abs(event.clientY - (r.top + r.height / 2)) < r.height * .18;
          const after = event.clientY > r.top + r.height / 2 ||
            (horizontalBand && event.clientX > r.left + r.width / 2);

          const reference = after ? target.nextSibling : target;
          if(reference !== drag.card){
            board.insertBefore(drag.card, reference);
          }
        }, {passive:false});

        function finishDrag(event){
          if(!drag || event.pointerId !== drag.pointerId) return;

          drag.card.classList.remove('is-drag-source');
          drag.ghost.remove();
          document.body.classList.remove('is-dragging-cards');
          drag = null;
        }

        document.addEventListener('pointerup', finishDrag);
        document.addEventListener('pointercancel', finishDrag);
      }

</script>

