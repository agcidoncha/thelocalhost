---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="container" style="padding: 4rem 0;">
    <p style="font-family: var(--mono); color: var(--accent-3); letter-spacing: 0.08em; text-transform: uppercase;">
      Migración a Astro — en curso
    </p>
    <h1 style="font-family: 'Bebas Neue', sans-serif; font-weight: 400; font-size: clamp(2.5rem, 6vw, 4.5rem); margin-top: 1rem;">
      The Localhost
    </h1>
    <p style="color: var(--ink-soft); max-width: 60ch; margin-top: 1rem;">
      Base de Astro creada: layout, tokens de diseño y estilos globales listos.
      Los componentes reales (header, hero, objetivos, método, diagnóstico) se
      migran por fases siguiendo <code>migracion-astro.md</code>.
    </p>
  </main>
</BaseLayout>
